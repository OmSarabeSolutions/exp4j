						{
							"_type": "UMLInteraction",
							"_id": "RXhwNGpNAAAAAA6M",
							"_parent": {
								"$ref": "RXhwNGpNAAAAAA6L"
							},
							"name": "20 · Sequence — Build an expression",
							"documentation": "ExpressionBuilder collects the variable names, the user functions and operators and the evaluation strategy, then build() adds the constants (pi, π, e, φ), checks that no variable is named like a function, and has ShuntingYard convert the text to reverse Polish notation, reading it token by token from a Tokenizer. The new Expression gives each variable a slot and compiles its tokens into a CompiledExpression (null if they are malformed); with BYTECODE, BytecodeCompiler turns it into a hidden class, or returns null where classes cannot be defined at runtime, and the interpreter is used.",
							"ownedElements": [
								{
									"_type": "UMLSequenceDiagram",
									"_id": "0YFs1ZLr2Dp8ORM7pgAA",
