										{
											"_type": "UMLClass",
											"_id": "4E7zsGfY9bqlX5OaejsA",
											"_parent": {
												"$ref": "RXhwNGpNAAAAAAkL"
											},
											"name": "BytecodeCompiler",
											"documentation": "Translates a CompiledExpression into a hidden class whose evaluate method is straight-line JVM bytecode, so that the JIT compiles the expression like hand-written Java. Built-ins are emitted as direct calls to their tiny implementing method in Builtins, which the JIT always inlines, independently of how polluted the shared profiles are. Each variable is checked and loaded into a local once, at its first use. Custom operators and functions are called through apply(double...) on instances held by the generated object. Only java.base is required (java.lang.classfile, java.lang.invoke), so the strategy works in jlink-ed runtime images. Hidden classes are defined in this module's package and are unloaded when their expression becomes unreachable.",
											"isLeaf": true,
											"operations": [
												{
													"_type": "UMLOperation",
													"_id": "Qx4UrZTB+TAkIdsmFZIA",
													"_parent": {
														"$ref": "4E7zsGfY9bqlX5OaejsA"
													},
